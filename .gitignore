# Deny everything, then allow only what belongs in the repo.
*
!*/

!.gitignore
!README.md
!LICENSE
!NOTICE

# Gradle / project scripts
!gradlew
!gradlew.bat
!settings.gradle.kts
!build.gradle.kts
!gradle.properties
!.editorconfig
!config/
!config/**
!gradle/libs.versions.toml
!gradle/gradle-daemon-jvm.properties
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# App sources and module script
!app/build.gradle.kts
!app/proguard-rules.pro
!app/src/
!app/src/**

# README demos (GIFs recorded on device; see scripts/record-media.sh)
!docs/
!docs/**
!scripts/
!scripts/**

# Secrets, machine paths, IDE, build, binaries - even if someone un-ignores a folder
.gradle/
.kotlin/
.idea/
.cursor/
.vscode/
.DS_Store
local.properties
**/.DS_Store
**/.env
**/.env.*
**/*.iml
**/*.apk
**/*.aab
**/*.ap_
**/*.dex
**/*.class
**/*.jar
**/*.war
**/*.ear
**/*.so
**/*.keystore
**/*.jks
**/*.p12
**/*.pem
**/*.key
**/*.crt
**/google-services.json
**/google-services.json.*
**/GoogleService-Info.plist
**/*.hprof
**/*.log
**/build/
**/captures/
**/.externalNativeBuild/
**/.cxx/
**/out/
**/tmp/
**/*.orig
**/*.bak
**/*~
**/Thumbs.db

# Wrapper is the only jar that must be tracked
!gradle/wrapper/gradle-wrapper.jar
